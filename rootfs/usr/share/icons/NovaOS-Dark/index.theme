[Icon Theme]
Name=NovaOS-Dark
Comment=Original NovaOS icons (apps, places); everything else from Papirus
Inherits=Papirus-Dark,breeze-dark,hicolor
Example=folder
Directories=scalable/apps,scalable/places

[scalable/apps]
Size=128
MinSize=8
MaxSize=512
Context=Applications
Type=Scalable

[scalable/places]
Size=128
MinSize=8
MaxSize=512
Context=Places
Type=Scalable
